<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Projet21092026_001.Vues.DetailAthentificationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Détail authentification">

    <VerticalStackLayout
        Padding="30"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="Résultat de l'authentification"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Username}"
            FontSize="18"
            HorizontalOptions="Center" />

        <Label
            Text="{Binding Message}"
            FontSize="22"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Button
            Text="Retour"
            Command="{Binding RetourCommand}" />

    </VerticalStackLayout>

</ContentPage>